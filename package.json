{
  "name": "solara",
  "private": true,
  "version": "0.1.0",
  "description": "SOLARA — Martian surface-intelligence and mission-planning application (NASA Space Apps Challenge 2026)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:copilot": "wrangler dev --config worker/wrangler.toml --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "typecheck:copilot": "tsc --noEmit -p worker",
    "test:map": "node --import ./tests/science/ts-resolve-hook.mjs --test tests/map/tile-cache.test.mjs tests/map/mars-globe-coordinates.test.mjs tests/map/global-exploration.test.mjs",
    "test:science": "node --import ./tests/science/ts-resolve-hook.mjs --test tests/science/dem-slope.test.mjs tests/science/coverage.test.mjs tests/science/meda.test.mjs tests/science/rover.test.mjs tests/science/route-window.test.mjs tests/science/route-planner.test.mjs tests/science/dem-tiff-decode.test.mjs",
    "test:worker": "node --import ./tests/worker/resolve-hook.mjs --test tests/worker/tools.test.mjs",
    "test": "npm run test:map && npm run test:science && npm run test:worker",
    "deploy": "npm run build && wrangler deploy"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cesium": "1.140.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "ol": "^10.11.0",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "wrangler": "^4.162.0"
  }
}
